# ── Fireboy & Watergirl Co-op ──
# Copy to .env for dev, .env.production for prod

# Server
PORT=3000
GRPC_PORT=50051
NODE_ENV=development   # change to production for prod

# Auth
# Generate secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-change-in-production

# CORS — MUST be set in production (e.g., https://fireboy-coop.alpeerkaraca.me)
# Leave empty for dev (defaults to *)
CORS_ORIGIN=http://localhost:3000

# App URL (used in magic link emails)
APP_URL=http://localhost:3000

# ── Database ──
# Dev: SQLite (no container needed)
DATABASE_URL="file:./prisma/dev.db"

# Production: PostgreSQL (requires podman container)
# DATABASE_URL="postgresql://fwuser:YOUR_PG_PASSWORD@127.0.0.1:54322/fireboycoop"

# ── Cache (Valkey) ──
# Production: set VALKEY_URL and password
# VALKEY_URL=redis://127.0.0.1:54323
# VALKEY_PASSWORD=your-valkey-password

# ── Email (Gmail SMTP) ──
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
#    App: "Mail", Device: "Other" → name "Fireboy Co-op"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=yourname@gmail.com

# ── WebRTC TURN (production only) ──
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your-turn-username
# TURN_PASSWORD=your-turn-credential

# Container passwords (for podman-compose)
PG_PASSWORD=fw_dev_password_change_me
VALKEY_PASSWORD=fw_dev_password_change_me
